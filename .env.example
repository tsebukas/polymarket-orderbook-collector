# ClickHouse (infra compose creates the `default` user with this password)
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Archive exporter destination — not needed for the collector itself.
# Pick one: LOCAL_OUTPUT_DIR writes hourly Parquet to a directory and needs no
# credentials; otherwise all four R2 variables are required.
LOCAL_OUTPUT_DIR=

# Cloudflare R2. Your account's endpoint: https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY=
R2_SECRET_KEY=
