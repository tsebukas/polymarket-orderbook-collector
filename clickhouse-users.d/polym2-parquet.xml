<?xml version="1.0"?>
<!--
  polym2: let the hourly export finish on a memory-constrained box.

  Mounted into /etc/clickhouse-server/users.d/ by docker-compose.infra.polym2.yml.
  These are query-level settings, so they belong in a profile rather than in the
  server config next door.

  What the exporter actually sends, which took a while to establish and is worth
  writing down because it is not what it looks like from the outside:

    SELECT timestamp_received, timestamp, market, event_type,
           JSONExtractString(data, 'asset_id') AS asset_id, ...
    FROM polymarket_orderbook_rust
    WHERE timestamp_received >= <hour> AND timestamp_received < <hour> + 1 HOUR
    ORDER BY market, asset_id, timestamp_received
    FORMAT ArrowStream

  Two things follow. It sorts the whole hour, which at our volume is 25M to 153M
  rows and is where the memory goes: failing exports reported 6.65 GiB of query
  memory. And it streams Arrow, writing the Parquet client-side, so none of the
  output_format_parquet_* settings below ever touched it; those only apply to
  ad-hoc FORMAT Parquet queries run by hand.

  Careful with comments here: XML forbids a double hyphen inside one, and
  ClickHouse refuses to start on a malformed config rather than skipping it.
-->
<clickhouse>
    <profiles>
        <default>
            <!-- The fix. Above this much, the sort spills to disk instead of
                 being held whole. Sorting an hour is inherent to how the
                 exporter builds its files, so the choice is between spilling and
                 failing; there is 270 GB free and the export has an hour to
                 write an hour. -->
            <max_bytes_before_external_sort>2147483648</max_bytes_before_external_sort>

            <!-- Pace the reader against whatever consumes the result. With
                 default parallelism ClickHouse reads far faster than the client
                 writes and buffers the difference. Measured on hour 16, 153M
                 rows, on a hand-run SELECT * FORMAT Parquet:

                   default threads  failed at 3.64 GB after 188 s
                   max_threads=2    failed at 1.33 GB after  48 s
                   max_threads=1    COMPLETE, 5.54 GB in 394 s

                 394 seconds to write an hour that took 3600 to collect is not a
                 constraint worth optimising away. -->
            <max_threads>1</max_threads>

            <!-- For hand-run FORMAT Parquet queries only, per the note above.
                 ClickHouse buffers a whole row group before writing it and the
                 defaults are 1M rows / 512 MB, which is far too much here. -->
            <output_format_parquet_row_group_size>10000</output_format_parquet_row_group_size>
            <output_format_parquet_row_group_size_bytes>8388608</output_format_parquet_row_group_size_bytes>
        </default>
    </profiles>
</clickhouse>
